# Copy to .env.local for local development.
# In production, set these in the Vercel project (Settings -> Environment
# Variables) — never commit real values.

# --- Snapchat Ads Pixel (optional) ---
# Not a secret — Snap Pixel IDs are meant to appear in page source. Defaults
# to the Crystal Clean Laundry pixel already hardcoded as a fallback in
# src/lib/tracking.ts, so this only needs setting if you ever switch pixels.
NEXT_PUBLIC_SNAP_PIXEL_ID=8b94037b-81c2-46e4-b420-56411c17d9e8

# --- Supabase (Project Settings > API in the Supabase dashboard) ---
SUPABASE_URL=https://ovufnxrbzdfipouaiibh.supabase.co
SUPABASE_ANON_KEY=
# Service role / "Secret key" — full database access, bypasses RLS.
# NEVER expose this in client-side code or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin portal login (choose your own — do not reuse elsewhere) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_JWT_SECRET=
